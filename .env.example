# ==============================================================================
# RAMA — PostgreSQL medallon — variables de entorno
# ==============================================================================
# Copia este archivo como .env y ajusta los valores.
# docker compose lee .env automaticamente.
#
# Todas las variables tienen defaults seguros para desarrollo local.
# En produccion, cambia POSTGRES_PASSWORD y DATABASE_URL.
# ==============================================================================

# PostgreSQL
POSTGRES_USER=rama
POSTGRES_PASSWORD=rama
POSTGRES_DB=rama
PG_PORT=5433

# API (FastAPI)
DATABASE_URL=postgresql://rama:rama@postgres:5432/rama
API_PORT=8080
