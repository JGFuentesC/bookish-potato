# Plantilla de variables (documentación). Los valores reales los exporta direnv:
# copia tus overrides a .envrc.local (gitignored). Ejemplo:
#   export POSTGRES_PASSWORD=<tu_password>
#   export OLLAMA_BASE_URL=http://<ip-platypy>:11434
POSTGRES_USER=genbi
