# Copiar a `.env` y completar los valores (`.env` NO se versiona).
# Generar claves: openssl rand -hex 32
#
# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_ETL_USER=etl
MYSQL_ETL_PASSWORD=cambiar_etl_password
MYSQL_DASHBOARDS_USER=dashboards
MYSQL_DASHBOARDS_PASSWORD=cambiar_dashboards_password

# --- Apache Superset ---
SUPERSET_SECRET_KEY=genera_con_openssl_rand_hex_32
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=cambiar_admin_password
