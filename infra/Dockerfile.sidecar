FROM python:3.12.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY ai-sidecar/pyproject.toml ai-sidecar/uv.lock ./
COPY ai-sidecar/src ./src
COPY ai-sidecar/semantic ./semantic
RUN uv sync --frozen --no-dev
RUN useradd --create-home --uid 10001 genbi && chown -R genbi:genbi /app
USER genbi
EXPOSE 8000
HEALTHCHECK CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
CMD ["uv", "run", "--no-sync", "uvicorn", "genbi_ai.api.main:app", "--host", "0.0.0.0", "--port", "8000"]