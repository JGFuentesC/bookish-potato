# Plantilla de direnv (documentación). Copia a `.envrc` (gitignored) para uso
# local con `direnv allow .`. Los overrides reales de cada máquina van en
# `.envrc.local` (también gitignored): exporta ahí POSTGRES_PASSWORD y
# OLLAMA_BASE_URL, juntos con cualquier secreto local.
source_env_if_exists .envrc.local

export POSTGRES_USER="${POSTGRES_USER:-genbi}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-}"
export POSTGRES_DB="${POSTGRES_DB:-genbi}"
export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://localhost:11434}"
export OLLAMA_LLM_MODEL="${OLLAMA_LLM_MODEL:-gemma4:latest}"
export LAKEHOUSE_PATH="${LAKEHOUSE_PATH:-lakehouse/gold}"
export SIDECAR_URL="${SIDECAR_URL:-http://localhost:8000}"
export QUERY_TIMEOUT_MS="${QUERY_TIMEOUT_MS:-30000}"
export MAX_ROWS="${MAX_ROWS:-1000}"
# Autenticación (POC): JWT_SECRET y credenciales demo. En producción inyectar
# valores fuertes desde el orquestador.
export JWT_SECRET="${JWT_SECRET:-}"
export AUTH_EMAIL="${AUTH_EMAIL:-user@genbi.com}"
export AUTH_PASSWORD="${AUTH_PASSWORD:-password123}"